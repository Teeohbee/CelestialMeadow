[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://results.gd" id="1_results"]
[ext_resource type="Script" path="res://art/ship_icon.gd" id="2_ship"]

[node name="Results" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_results")

[node name="Overlay" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0863, 0.0706, 0.122, 0.75)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Ship" type="Control" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
script = ExtResource("2_ship")

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Red Wins!"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Player 1"
horizontal_alignment = 1

[node name="TallyHeading" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Wins this session"

[node name="Tally" type="VBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Buttons" type="HBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1

[node name="RematchButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Rematch"

[node name="MenuButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Main Menu"

[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/RematchButton" to="." method="_on_rematch_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/MenuButton" to="." method="_on_menu_button_pressed"]
